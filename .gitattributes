# NORMALIZACIÓN PREDETERMINADA PARA TODOS LOS ARCHIVOS DE TEXTO
* text=auto eol=lf

# SCRIPTS QUE SE EJECUTAN PRINCIPALMENTE EN WINDOWS
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# ARCHIVOS BINARIOS
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.7z binary
