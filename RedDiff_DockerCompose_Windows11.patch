@@ -0,0 +1,42 @@
+[CmdletBinding()]
+param()
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+. (Join-Path $PSScriptRoot 'Comun.ps1')
+
+Assert-DockerLinuxDisponible
+Assert-ArchivosProduccion
+
+$RutaSecreto = Join-Path $script:RutaSecretos 'administrador_inicial_contrasena.txt'
+$Contrasena = $null
+$Confirmacion = $null
+
+try {
+    $ContrasenaSegura = Read-Host 'Contrasena del primer administrador' -AsSecureString
+    $ConfirmacionSegura = Read-Host 'Repita la contrasena' -AsSecureString
+    $Contrasena = ConvertTo-TextoPlanoTemporal -Valor $ContrasenaSegura
+    $Confirmacion = ConvertTo-TextoPlanoTemporal -Valor $ConfirmacionSegura
+
+    if ($Contrasena -cne $Confirmacion) {
+        throw 'Las contrasenas no coinciden.'
+    }
+
+    if ($Contrasena.Length -lt 12 -or $Contrasena.Length -gt 128) {
+        throw 'La contrasena debe contener entre 12 y 128 caracteres.'
+    }
+
+    [IO.File]::WriteAllText($RutaSecreto, $Contrasena, $script:CodificacionUtf8SinBom)
+    Invoke-RedDiffCompose -Argumentos @(
+        '--profile', 'herramientas',
+        'run', '--rm', 'inicializador'
+    )
+}
+finally {
+    [IO.File]::WriteAllText($RutaSecreto, '', $script:CodificacionUtf8SinBom)
+    $Contrasena = $null
+    $Confirmacion = $null
+}
+
+Write-Host 'La primera cuenta administrativa fue creada correctamente.' -ForegroundColor Green
diff --git a/automatizacion/powershell/produccion-docker/Preparar-Produccion.ps1 b/automatizacion/powershell/produccion-docker/Preparar-Produccion.ps1
new file mode 100644
index 0000000..f93431c
--- /dev/null
+++ b/automatizacion/powershell/produccion-docker/Preparar-Produccion.ps1
@@ -0,0 +1,111 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$NombreHost,
+    [string[]]$OrigenWeb = @('LocalSubnet'),
+    [string[]]$OrigenSyslog = @('LocalSubnet'),
+    [switch]$ConfigurarHostWindows,
+    [switch]$AgregarResolucionLocal
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+. (Join-Path $PSScriptRoot 'Comun.ps1')
+
+if ($NombreHost -notmatch '^[A-Za-z0-9.-]+$') {
+    throw 'El nombre del host contiene caracteres no permitidos.'
+}
+
+Assert-DockerLinuxDisponible
+Assert-Archivo -Ruta $script:RutaPlantillaEntorno
+Assert-Archivo -Ruta $script:RutaCompose
+
+if ($ConfigurarHostWindows -and -not (Test-EsAdministrador)) {
+    throw 'Abra PowerShell como administrador cuando utilice -ConfigurarHostWindows.'
+}
+
+if (-not (Test-Path -LiteralPath $script:RutaEntorno -PathType Leaf)) {
+    Copy-Item -LiteralPath $script:RutaPlantillaEntorno -Destination $script:RutaEntorno
+}
+
+Set-VariableEntorno -Nombre 'REDDIFF_NOMBRE_HOST' -Valor $NombreHost
+Set-VariableEntorno -Nombre 'REDDIFF_ORIGEN_CLIENTE' -Valor "https://$NombreHost"
+
+if (-not (Test-Path -LiteralPath $script:RutaSecretos -PathType Container)) {
+    New-Item -ItemType Directory -Path $script:RutaSecretos | Out-Null
+}
+
+Write-SecretoSiFalta -Ruta (Join-Path $script:RutaSecretos 'postgresql_contrasena.txt')
+Write-SecretoSiFalta -Ruta (Join-Path $script:RutaSecretos 'postgresql_aplicacion_contrasena.txt')
+
+$RutaAdministrador = Join-Path $script:RutaSecretos 'administrador_inicial_contrasena.txt'
+if (-not (Test-Path -LiteralPath $RutaAdministrador -PathType Leaf)) {
+    [IO.File]::WriteAllText($RutaAdministrador, '', $script:CodificacionUtf8SinBom)
+}
+
+$ArchivosCertificados = @(
+    'autoridad_certificadora.crt',
+    'autoridad_certificadora.key',
+    'postgresql_servidor.crt',
+    'postgresql_servidor.key',
+    'reddiff_https.crt',
+    'reddiff_https.key'
+)
+
+$Existentes = @($ArchivosCertificados | Where-Object {
+        Test-Path -LiteralPath (Join-Path $script:RutaSecretos $_) -PathType Leaf
+    })
+
+if ($Existentes.Count -gt 0 -and $Existentes.Count -lt $ArchivosCertificados.Count) {
+    throw "El conjunto de certificados esta incompleto. Revise $script:RutaSecretos; no se reemplazara material existente."
+}
+
+if ($Existentes.Count -eq 0) {
+    $RutaDockerfile = Join-Path $script:RutaRaiz 'infraestructura\contenedores\produccion\certificados\Dockerfile'
+    $Etiqueta = 'reddiff-certificados:local'
+    Assert-Archivo -Ruta $RutaDockerfile
+
+    Write-Host 'Construyendo la herramienta aislada para generar certificados...' -ForegroundColor Cyan
+    Invoke-Docker -Argumentos @(
+        'build',
+        '--file', $RutaDockerfile,
+        '--tag', $Etiqueta,
+        $script:RutaRaiz
+    )
+
+    $Montaje = "type=bind,source=$script:RutaSecretos,destination=/salida"
+    Invoke-Docker -Argumentos @(
+        'run', '--rm',
+        '--mount', $Montaje,
+        $Etiqueta,
+        $NombreHost
+    )
+}
+
+# Limita el acceso local a secretos al usuario actual, SYSTEM y administradores.
+$SidUsuario = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
+& icacls $script:RutaSecretos '/inheritance:r' `
+    '/grant:r' "*${SidUsuario}:(OI)(CI)F" `
+    '*S-1-5-18:(OI)(CI)F' `
+    '*S-1-5-32-544:(OI)(CI)F' `
+    '/T' '/C' | Out-Null
+
+if ($LASTEXITCODE -ne 0) {
+    throw 'No fue posible proteger el directorio local de secretos con ACL de Windows.'
+}
+
+if ($ConfigurarHostWindows) {
+    $ArgumentosHost = @{
+        NombreHost = $NombreHost
+        OrigenWeb = $OrigenWeb
+        OrigenSyslog = $OrigenSyslog
+    }
+    if ($AgregarResolucionLocal) {
+        $ArgumentosHost.AgregarResolucionLocal = $true
+    }
+
+    & (Join-Path $PSScriptRoot 'Configurar-HostWindows.ps1') @ArgumentosHost
+}
+
+Write-Host "Preparacion completada para https://$NombreHost." -ForegroundColor Green
+Write-Host "Revise $script:RutaEntorno y luego ejecute Desplegar-Produccion.ps1."
diff --git a/automatizacion/powershell/produccion-docker/Respaldar-Produccion.ps1 b/automatizacion/powershell/produccion-docker/Respaldar-Produccion.ps1
new file mode 100644
index 0000000..ca1f08f
--- /dev/null
+++ b/automatizacion/powershell/produccion-docker/Respaldar-Produccion.ps1
@@ -0,0 +1,97 @@
+[CmdletBinding()]
+param()
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+. (Join-Path $PSScriptRoot 'Comun.ps1')
+
+Assert-DockerLinuxDisponible
+Assert-ArchivosProduccion
+Wait-ServicioSaludable -Servicio 'base-datos' -Intentos 5
+Wait-ServicioSaludable -Servicio 'api' -Intentos 5
+
+$RutaRespaldos = Join-Path $script:RutaRaiz 'respaldos\produccion'
+$MarcaTiempo = [DateTime]::UtcNow.ToString('yyyyMMddTHHmmssZ')
+$RutaFinal = Join-Path $RutaRespaldos "reddiff-$MarcaTiempo"
+$RutaTemporal = "$RutaFinal.tmp"
+
+New-Item -ItemType Directory -Path $RutaRespaldos -Force | Out-Null
+New-Item -ItemType Directory -Path $RutaTemporal | Out-Null
+
+$ContenedorBaseDatos = @(Invoke-RedDiffCompose -Argumentos @('ps', '--quiet', 'base-datos') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+$ContenedorApi = @(Invoke-RedDiffCompose -Argumentos @('ps', '--quiet', 'api') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+
+if ($ContenedorBaseDatos.Count -eq 0 -or $ContenedorApi.Count -eq 0) {
+    throw 'No se encontraron los contenedores requeridos para el respaldo.'
+}
+
+$IdBaseDatos = ([string] $ContenedorBaseDatos[0]).Trim()
+$IdApi = ([string] $ContenedorApi[0]).Trim()
+$RutaDumpContenedor = '/tmp/reddiff-respaldo.dump'
+
+try {
+    Invoke-Docker -Argumentos @(
+        'exec', $IdBaseDatos,
+        'sh', '-ec',
+        'export PGPASSWORD="$(cat /run/secrets/postgresql_contrasena)"; exec pg_dump --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --format=custom --no-password --file=/tmp/reddiff-respaldo.dump'
+    )
+
+    Invoke-Docker -Argumentos @(
+        'cp',
+        "${IdBaseDatos}:$RutaDumpContenedor",
+        (Join-Path $RutaTemporal 'base-datos.dump')
+    )
+
+    $VolumenClaves = @(Invoke-Docker -Argumentos @(
+            'inspect',
+            '--format', '{{range .Mounts}}{{if eq .Destination "/var/lib/reddiff/claves-proteccion"}}{{.Name}}{{end}}{{end}}',
+            $IdApi
+        ) -Capturar | Select-Object -First 1)
+
+    if ($VolumenClaves.Count -eq 0 -or [string]::IsNullOrWhiteSpace([string] $VolumenClaves[0])) {
+        throw 'No se encontro el volumen de claves de proteccion.'
+    }
+
+    $NombreVolumen = ([string] $VolumenClaves[0]).Trim()
+    $MontajeDestino = "type=bind,source=$RutaTemporal,destination=/destino"
+    Invoke-Docker -Argumentos @(
+        'run', '--rm',
+        '--volume', "${NombreVolumen}:/origen:ro",
+        '--mount', $MontajeDestino,
+        'alpine:3.22',
+        'tar', '-czf', '/destino/claves-proteccion.tar.gz', '-C', '/origen', '.'
+    )
+
+    $Archivos = @('base-datos.dump', 'claves-proteccion.tar.gz')
+    $Lineas = foreach ($Archivo in $Archivos) {
+        $Hash = Get-FileHash -LiteralPath (Join-Path $RutaTemporal $Archivo) -Algorithm SHA256
+        "$($Hash.Hash.ToLowerInvariant())  $Archivo"
+    }
+
+    [IO.File]::WriteAllLines(
+        (Join-Path $RutaTemporal 'manifiesto.sha256'),
+        $Lineas,
+        $script:CodificacionUtf8SinBom
+    )
+
+    Move-Item -LiteralPath $RutaTemporal -Destination $RutaFinal
+}
+finally {
+    try {
+        Invoke-Docker -Argumentos @('exec', $IdBaseDatos, 'rm', '-f', $RutaDumpContenedor)
+    }
+    catch {
+        Write-Warning 'No fue posible retirar el archivo temporal del contenedor de PostgreSQL.'
+    }
+
+    if (Test-Path -LiteralPath $RutaTemporal -PathType Container) {
+        Remove-Item -LiteralPath $RutaTemporal -Recurse -Force
+    }
+}
+
+Write-Host "Respaldo creado: $RutaFinal" -ForegroundColor Green
diff --git a/automatizacion/powershell/produccion-docker/Restaurar-Produccion.ps1 b/automatizacion/powershell/produccion-docker/Restaurar-Produccion.ps1
new file mode 100644
index 0000000..d24bb09
--- /dev/null
+++ b/automatizacion/powershell/produccion-docker/Restaurar-Produccion.ps1
@@ -0,0 +1,117 @@
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory)][ValidateNotNullOrEmpty()][string]$RutaRespaldo,
+    [switch]$Confirmar
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+. (Join-Path $PSScriptRoot 'Comun.ps1')
+
+if (-not $Confirmar) {
+    throw 'La restauracion reemplaza la base de datos y las claves actuales. Repita con -Confirmar.'
+}
+
+Assert-DockerLinuxDisponible
+Assert-ArchivosProduccion
+
+$RutaRespaldo = [IO.Path]::GetFullPath($RutaRespaldo)
+if (-not (Test-Path -LiteralPath $RutaRespaldo -PathType Container)) {
+    throw "No existe el directorio de respaldo: $RutaRespaldo"
+}
+
+$RutaDump = Join-Path $RutaRespaldo 'base-datos.dump'
+$RutaClaves = Join-Path $RutaRespaldo 'claves-proteccion.tar.gz'
+$RutaManifiesto = Join-Path $RutaRespaldo 'manifiesto.sha256'
+Assert-Archivo -Ruta $RutaDump
+Assert-Archivo -Ruta $RutaClaves
+Assert-Archivo -Ruta $RutaManifiesto
+
+$Esperados = @{}
+foreach ($Linea in [IO.File]::ReadAllLines($RutaManifiesto)) {
+    if ($Linea -match '^([0-9a-fA-F]{64})\s+\*?(.+)$') {
+        $Esperados[$Matches[2].Trim()] = $Matches[1].ToLowerInvariant()
+    }
+}
+
+foreach ($Archivo in @('base-datos.dump', 'claves-proteccion.tar.gz')) {
+    if (-not $Esperados.ContainsKey($Archivo)) {
+        throw "El manifiesto no contiene $Archivo."
+    }
+
+    $Actual = (Get-FileHash -LiteralPath (Join-Path $RutaRespaldo $Archivo) -Algorithm SHA256).Hash.ToLowerInvariant()
+    if ($Actual -cne $Esperados[$Archivo]) {
+        throw "La integridad de $Archivo no coincide con el manifiesto."
+    }
+}
+
+Invoke-RedDiffCompose -Argumentos @('stop', 'web', 'api')
+Invoke-RedDiffCompose -Argumentos @('up', '--detach', 'base-datos')
+Wait-ServicioSaludable -Servicio 'base-datos' -Intentos 60
+
+$ContenedorBaseDatos = @(Invoke-RedDiffCompose -Argumentos @('ps', '--quiet', 'base-datos') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+$ContenedorApi = @(Invoke-RedDiffCompose -Argumentos @('ps', '--all', '--quiet', 'api') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+
+if ($ContenedorBaseDatos.Count -eq 0 -or $ContenedorApi.Count -eq 0) {
+    throw 'No se encontraron los contenedores requeridos para restaurar RedDiff.'
+}
+
+$IdBaseDatos = ([string] $ContenedorBaseDatos[0]).Trim()
+$IdApi = ([string] $ContenedorApi[0]).Trim()
+$RutaDumpContenedor = '/tmp/reddiff-restauracion.dump'
+
+try {
+    Invoke-Docker -Argumentos @('cp', $RutaDump, "${IdBaseDatos}:$RutaDumpContenedor")
+
+    Invoke-Docker -Argumentos @(
+        'exec', $IdBaseDatos,
+        'sh', '-ec',
+        'export PGPASSWORD="$(cat /run/secrets/postgresql_contrasena)"; dropdb --host=127.0.0.1 --username="$POSTGRES_USER" --if-exists --force "$POSTGRES_DB"; createdb --host=127.0.0.1 --username="$POSTGRES_USER" --owner="$POSTGRES_USER" "$POSTGRES_DB"; pg_restore --host=127.0.0.1 --username="$POSTGRES_USER" --dbname="$POSTGRES_DB" --no-owner --no-privileges /tmp/reddiff-restauracion.dump'
+    )
+
+    $VolumenClaves = @(Invoke-Docker -Argumentos @(
+            'inspect',
+            '--format', '{{range .Mounts}}{{if eq .Destination "/var/lib/reddiff/claves-proteccion"}}{{.Name}}{{end}}{{end}}',
+            $IdApi
+        ) -Capturar | Select-Object -First 1)
+
+    if ($VolumenClaves.Count -eq 0 -or [string]::IsNullOrWhiteSpace([string] $VolumenClaves[0])) {
+        throw 'No se encontro el volumen de claves de proteccion.'
+    }
+
+    $NombreVolumen = ([string] $VolumenClaves[0]).Trim()
+    $MontajeRespaldo = "type=bind,source=$RutaRespaldo,destination=/respaldo,readonly"
+    Invoke-Docker -Argumentos @(
+        'run', '--rm',
+        '--volume', "${NombreVolumen}:/destino",
+        '--mount', $MontajeRespaldo,
+        'alpine:3.22',
+        'sh', '-ec',
+        'find /destino -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +; tar -xzf /respaldo/claves-proteccion.tar.gz -C /destino; chown -R 1654:1654 /destino; chmod 0700 /destino'
+    )
+
+    Invoke-RedDiffCompose -Argumentos @(
+        'exec', '--no-TTY', 'base-datos',
+        'sh', '/opt/reddiff/herramientas/configurar-usuario-aplicacion.sh'
+    )
+
+    Invoke-RedDiffCompose -Argumentos @('up', '--detach', 'api', 'web')
+    Wait-ServicioSaludable -Servicio 'api' -Intentos 60
+    Wait-ServicioSaludable -Servicio 'web' -Intentos 60
+}
+finally {
+    try {
+        Invoke-Docker -Argumentos @('exec', $IdBaseDatos, 'rm', '-f', $RutaDumpContenedor)
+    }
+    catch {
+        Write-Warning 'No fue posible retirar el archivo temporal de restauracion.'
+    }
+}
+
+& (Join-Path $PSScriptRoot 'Verificar-Produccion.ps1')
+Write-Host 'RedDiff se restauro y verifico correctamente.' -ForegroundColor Green
diff --git a/automatizacion/powershell/produccion-docker/Verificar-Produccion.ps1 b/automatizacion/powershell/produccion-docker/Verificar-Produccion.ps1
new file mode 100644
index 0000000..67d2cc5
--- /dev/null
+++ b/automatizacion/powershell/produccion-docker/Verificar-Produccion.ps1
@@ -0,0 +1,86 @@
+[CmdletBinding()]
+param()
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+
+. (Join-Path $PSScriptRoot 'Comun.ps1')
+
+Assert-DockerLinuxDisponible
+Assert-ArchivosProduccion
+
+Wait-ServicioSaludable -Servicio 'base-datos' -Intentos 5
+Wait-ServicioSaludable -Servicio 'api' -Intentos 5
+Wait-ServicioSaludable -Servicio 'web' -Intentos 5
+
+$NombreHost = Get-VariableEntorno -Nombre 'REDDIFF_NOMBRE_HOST'
+$PuertoHttps = [int] (Get-VariableEntorno -Nombre 'REDDIFF_HTTPS_PUERTO')
+$PuertoSyslog = [int] (Get-VariableEntorno -Nombre 'REDDIFF_SYSLOG_PUERTO_PUBLICO')
+$Uri = "https://${NombreHost}:$PuertoHttps/salud/listo"
+
+try {
+    $Respuesta = Invoke-WebRequest -Uri $Uri -UseBasicParsing -TimeoutSec 15
+}
+catch {
+    throw "No fue posible validar $Uri. Compruebe la resolucion del nombre y la confianza del certificado. $($_.Exception.Message)"
+}
+
+if ($Respuesta.StatusCode -ne 200) {
+    throw "El endpoint de salud devolvio HTTP $($Respuesta.StatusCode)."
+}
+
+$ContenedorBaseDatos = @(Invoke-RedDiffCompose -Argumentos @('ps', '--quiet', 'base-datos') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+$ContenedorApi = @(Invoke-RedDiffCompose -Argumentos @('ps', '--quiet', 'api') -Capturar |
+    Where-Object { -not [string]::IsNullOrWhiteSpace([string] $_) } |
+    Select-Object -First 1)
+
+if ($ContenedorBaseDatos.Count -eq 0 -or $ContenedorApi.Count -eq 0) {
+    throw 'No se encontraron los contenedores necesarios para validar los puertos publicados.'
+}
+
+$PublicacionBaseDatos = @(Invoke-Docker -Argumentos @(
+        'inspect',
+        '--format', '{{json (index .NetworkSettings.Ports "5432/tcp")}}',
+        ([string] $ContenedorBaseDatos[0]).Trim()
+    ) -Capturar | Where-Object {
+        -not [string]::IsNullOrWhiteSpace([string] $_) -and ([string] $_).Trim() -ne 'null'
+    })
+
+if ($PublicacionBaseDatos.Count -gt 0) {
+    throw "PostgreSQL no debe estar publicado en Windows: $($PublicacionBaseDatos -join ', ')"
+}
+
+$PuertoWeb = Test-NetConnection -ComputerName '127.0.0.1' -Port $PuertoHttps -InformationLevel Quiet
+if (-not $PuertoWeb) {
+    throw "Windows no puede alcanzar el puerto HTTPS $PuertoHttps."
+}
+
+$SalidaPublicacionSyslog = @(Invoke-Docker -Argumentos @(
+        'inspect',
+        '--format', '{{json (index .NetworkSettings.Ports "5514/udp")}}',
+        ([string] $ContenedorApi[0]).Trim()
+    ) -Capturar | Select-Object -First 1)
+
+if ($SalidaPublicacionSyslog.Count -eq 0 -or
+    [string]::IsNullOrWhiteSpace([string] $SalidaPublicacionSyslog[0]) -or
+    ([string] $SalidaPublicacionSyslog[0]).Trim() -eq 'null') {
+    throw "No se encontro la publicacion UDP de Syslog esperada en el puerto $PuertoSyslog."
+}
+
+$PublicacionesSyslog = @(([string] $SalidaPublicacionSyslog[0]) | ConvertFrom-Json)
+$PuertoSyslogCorrecto = @($PublicacionesSyslog | Where-Object {
+        [int] ($_.HostPort) -eq $PuertoSyslog
+    })
+
+if ($PuertoSyslogCorrecto.Count -eq 0) {
+    $PuertosEncontrados = @($PublicacionesSyslog | ForEach-Object { $_.HostPort }) -join ', '
+    throw "Syslog no esta publicado en UDP $PuertoSyslog. Puertos encontrados: $PuertosEncontrados."
+}
+
+Invoke-RedDiffCompose -Argumentos @('ps')
+Write-Host "Salud HTTPS confirmada en $Uri." -ForegroundColor Green
+Write-Host "Syslog publicado en UDP $PuertoSyslog."
+Write-Host 'PostgreSQL permanece sin publicacion en el host.'
+Write-Host 'La verificacion tecnica de RedDiff finalizo correctamente.' -ForegroundColor Green
