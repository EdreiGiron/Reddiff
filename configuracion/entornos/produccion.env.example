# IDENTIDAD DEL DESPLIEGUE
REDDIFF_VERSION=local
REDDIFF_NOMBRE_HOST=reddiff.labymed.local
REDDIFF_ORIGEN_CLIENTE=https://reddiff.labymed.local
REDDIFF_HTTPS_PUERTO=443
REDDIFF_ZONA_HORARIA=America/Guatemala

# POSTGRESQL
REDDIFF_BD_NOMBRE=reddiff
REDDIFF_BD_USUARIO_ADMIN=reddiff_admin
REDDIFF_BD_USUARIO_APLICACION=reddiff_app

# SEGURIDAD DE LA APLICACIÓN
REDDIFF_ADMINISTRADOR_INICIAL=administrador.principal
REDDIFF_DURACION_SESION_MINUTOS=30
REDDIFF_LIMITE_INICIO_SESION=10

# RECEPCIÓN SYSLOG
REDDIFF_SYSLOG_HABILITADO=true
REDDIFF_SYSLOG_PUERTO_PUBLICO=514
